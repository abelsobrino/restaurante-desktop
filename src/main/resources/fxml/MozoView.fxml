<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.restaurante.controller.MozoController">

    <padding>
        <Insets bottom="40" left="40" right="40" top="40"/>
    </padding>

    <Text fill="#2e7d32" fontSmoothingType="GRAY" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-family: Arial; -fx-font-size: 24px; -fx-font-weight: bold;" text="PANEL MOZO" textAlignment="CENTER"/>

    <Text fx:id="txtUsuario" fill="#666666" fontSmoothingType="GRAY" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-family: Arial; -fx-font-size: 14px;" text="Usuario: " textAlignment="CENTER"/>

    <Separator prefWidth="300.0"/>

    <Label style="-fx-font-size: 14px;" text="Modulo en construccion..." textFill="#666666"/>

    <Button onAction="#cerrarSesion" prefWidth="150.0" style="-fx-background-color: #b71c1c; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8px 0px; -fx-background-radius: 5px;" text="CERRAR SESION"/>

</VBox>