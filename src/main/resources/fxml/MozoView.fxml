<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.restaurante.controller.MozoController" style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2e7d32; -fx-padding: 10px 20px;">
            <Text fill="white" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="RESTAURANTE UTP - MOZO"/>
            <Text fx:id="txtUsuario" fill="#e8f5e9" style="-fx-font-size: 14px;" text="Usuario: "/>
            <Text fx:id="txtMesaSeleccionada" fill="#e8f5e9" style="-fx-font-size: 14px;" text="Mesa: Ninguna"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#cerrarSesion" style="-fx-background-color: #b71c1c; -fx-text-fill: white; -fx-font-weight: bold;" text="CERRAR SESION"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.2, 0.55" style="-fx-background-color: transparent;">

            <!-- PANEL IZQUIERDO: MESAS -->
            <VBox spacing="10" style="-fx-padding: 15px;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="MESAS"/>
                <ListView fx:id="lstMesas" prefHeight="400.0"/>
                <Button fx:id="btnLiberarMesa" onAction="#liberarMesa" style="-fx-background-color: #b71c1c; -fx-text-fill: white; -fx-font-weight: bold;" text="LIBERAR MESA"/>
            </VBox>

            <!-- PANEL CENTRAL: PLATOS -->
            <VBox spacing="10" style="-fx-padding: 15px;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="CARTA - PLATOS DISPONIBLES"/>
                <TextField fx:id="txtBuscarPlato" promptText="Buscar plato..."/>
                <ListView fx:id="lstPlatos" prefHeight="300.0"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Label text="Cantidad:"/>
                    <Spinner fx:id="spnCantidad" editable="true" initialValue="1" min="1" max="20" prefWidth="70"/>
                    <Button fx:id="btnAgregarPlato" onAction="#agregarPlato" style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold;" text="AGREGAR +"/>
                </HBox>
            </VBox>

            <!-- PANEL DERECHO: PEDIDO -->
            <VBox spacing="10" style="-fx-padding: 15px;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="PEDIDO ACTUAL"/>
                <TableView fx:id="tblPedido" prefHeight="250.0"/>
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Label style="-fx-font-weight: bold;" text="Subtotal:"/>
                    <Label fx:id="lblSubtotal" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1a237e;" text="S/ 0.00"/>
                </HBox>
                <TextArea fx:id="txtObservacion" promptText="Observación del pedido (ej: sin cebolla, bien cocido)" prefHeight="50.0" wrapText="true"/>
                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnEnviarCocina" onAction="#enviarCocina" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px;" text="ENVIAR A COCINA"/>
                    <Button fx:id="btnTerminarPedido" onAction="#terminarPedido" style="-fx-background-color: #e65100; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px;" text="TERMINAR PEDIDO"/>
                    <Button fx:id="btnCancelarPedido" onAction="#cancelarPedido" style="-fx-background-color: #b71c1c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px;" text="CANCELAR"/>
                </HBox>
            </VBox>

        </SplitPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #e0e0e0; -fx-padding: 10px;">
            <Button fx:id="btnRegresar" onAction="#regresar" style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 25px;" text="REGRESAR AL PRINCIPAL"/>
        </HBox>
    </bottom>

</BorderPane>