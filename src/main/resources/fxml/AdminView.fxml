<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.restaurante.controller.AdminController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #0d47a1; -fx-padding: 10px 20px;">
            <Text fill="white" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="RESTAURANTE LA FONDA - ADMINISTRADOR"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#cerrarSesion" style="-fx-background-color: #b71c1c; -fx-text-fill: white; -fx-font-weight: bold;" text="CERRAR SESION"/>
        </HBox>
    </top>

    <center>
        <TabPane style="-fx-padding: 10px;">

            <Tab text="ESTADÍSTICAS" closable="false">
                <VBox spacing="15" style="-fx-padding: 20px;">

                    <HBox spacing="15" alignment="CENTER">
                        <ComboBox fx:id="cmbFiltroPeriodo" prefWidth="150.0"/>
                        <Button onAction="#actualizarEstadisticas" style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold;" text="ACTUALIZAR"/>
                    </HBox>

                    <GridPane hgap="20" vgap="10">
                        <VBox spacing="5" style="-fx-background-color: #e8f5e9; -fx-padding: 15px; -fx-border-radius: 5px;">
                            <Label text="Total Ventas" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblTotalVentas" style="-fx-font-size: 20px; -fx-text-fill: #2e7d32;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1" spacing="5" style="-fx-background-color: #e3f2fd; -fx-padding: 15px; -fx-border-radius: 5px;">
                            <Label text="Total Pedidos" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblTotalPedidos" style="-fx-font-size: 20px; -fx-text-fill: #0d47a1;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="2" spacing="5" style="-fx-background-color: #fff3e0; -fx-padding: 15px; -fx-border-radius: 5px;">
                            <Label text="Platos Vendidos" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblTotalPlatosVendidos" style="-fx-font-size: 20px; -fx-text-fill: #e65100;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="3" spacing="5" style="-fx-background-color: #fce4ec; -fx-padding: 15px; -fx-border-radius: 5px;">
                            <Label text="Ticket promedio" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblTotalUsuarios" style="-fx-font-size: 20px; -fx-text-fill: #b71c1c;"/>
                        </VBox>
                    </GridPane>




                    <Label text="LOS 5 PLATOS MÁS VENDIDOS" style="-fx-font-weight: bold;"/>
                    <ListView fx:id="lstMasVendidos" prefHeight="125"/>
                    <Label text="VENTAS REALIZADAS" style="-fx-font-weight: bold;"/>
                    <TableView fx:id="tblVentas" prefHeight="230" VBox.vgrow="ALWAYS"/>
                    <Label fx:id="lblActualizacion" wrapText="true"/>

                </VBox>
            </Tab>

            <Tab text="USUARIOS" closable="false">
                <SplitPane dividerPositions="0.6" style="-fx-background-color: transparent;">
                    <VBox spacing="10" style="-fx-padding: 10px;">
                        <Label style="-fx-font-weight: bold;" text="LISTA DE USUARIOS"/>
                        <TableView fx:id="tblUsuarios" prefHeight="400.0"/>
                    </VBox>
                    <VBox spacing="10" style="-fx-padding: 10px;">
                        <Label style="-fx-font-weight: bold;" text="FORMULARIO"/>
                        <TextField fx:id="txtDni" promptText="DNI"/>
                        <TextField fx:id="txtNombre" promptText="Nombre"/>
                        <TextField fx:id="txtApellido" promptText="Apellido"/>
                        <TextField fx:id="txtEmail" promptText="Email"/>
                        <PasswordField fx:id="txtPassword" promptText="Contraseña"/>
                        <ComboBox fx:id="cmbRol" promptText="Rol"/>
                        <HBox spacing="10">
                            <Button text="NUEVO" onAction="#limpiarFormularioUsuario"/>
                            <Button fx:id="btnGuardarUsuario" onAction="#guardarUsuario" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;" text="GUARDAR"/>
                            <Button fx:id="btnEliminarUsuario" onAction="#eliminarUsuario" style="-fx-background-color: #b71c1c; -fx-text-fill: white; -fx-font-weight: bold;" text="BAJA / REACTIVAR"/>
                        </HBox>
                    </VBox>
                </SplitPane>
            </Tab>

            <Tab text="MESAS" closable="false">
                <SplitPane dividerPositions="0.6" style="-fx-background-color: transparent;">
                    <VBox spacing="10" style="-fx-padding: 10px;">
                        <Label style="-fx-font-weight: bold;" text="LISTA DE MESAS"/>
                        <TableView fx:id="tblMesas" prefHeight="400.0"/>
                    </VBox>
                    <VBox spacing="10" style="-fx-padding: 10px;">
                        <Label style="-fx-font-weight: bold;" text="FORMULARIO"/>
                        <TextField fx:id="txtNumeroMesa" promptText="Número"/>
                        <TextField fx:id="txtCapacidadMesa" promptText="Capacidad"/>
                        <ComboBox fx:id="cmbEstadoMesa" promptText="Estado"/>
                        <HBox spacing="10">
                            <Button fx:id="btnGuardarMesa" onAction="#guardarMesa" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;" text="GUARDAR"/>
                            <Button fx:id="btnEliminarMesa" onAction="#eliminarMesa" style="-fx-background-color: #b71c1c; -fx-text-fill: white; -fx-font-weight: bold;" text="ELIMINAR"/>
                        </HBox>
                    </VBox>
                </SplitPane>
            </Tab>

            <Tab text="PLATOS" closable="false">
                <SplitPane dividerPositions="0.6" style="-fx-background-color: transparent;">
                    <VBox spacing="10" style="-fx-padding: 10px;">
                        <Label style="-fx-font-weight: bold;" text="LISTA DE PLATOS"/>
                        <TableView fx:id="tblPlatos" prefHeight="400.0"/>
                    </VBox>
                    <VBox spacing="10" style="-fx-padding: 10px;">
                        <Label style="-fx-font-weight: bold;" text="FORMULARIO"/>
                        <TextField fx:id="txtNombrePlato" promptText="Nombre"/>
                        <TextField fx:id="txtDescripcionPlato" promptText="Descripción"/>
                        <TextField fx:id="txtPrecioPlato" promptText="Precio"/>
                        <ComboBox fx:id="cmbCategoriaPlato" promptText="Categoría"/>
                        <CheckBox fx:id="chkDisponiblePlato" text="Disponible"/>
                        <HBox spacing="10">
                            <Button fx:id="btnGuardarPlato" onAction="#guardarPlato" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;" text="GUARDAR"/>
                            <Button fx:id="btnEliminarPlato" onAction="#eliminarPlato" style="-fx-background-color: #b71c1c; -fx-text-fill: white; -fx-font-weight: bold;" text="ELIMINAR"/>
                        </HBox>
                        <Separator/>
                        <Label text="¿Tiene tamaños o cantidades? Ej.: x6/x12/x24 o Personal/Mediana/Familiar" wrapText="true" style="-fx-text-fill:#555555;"/>
                        <Button onAction="#abrirPlatosOpciones" maxWidth="Infinity"
                                style="-fx-background-color:#6a1b9a; -fx-text-fill:white; -fx-font-weight:bold;"
                                text="CREAR / EDITAR PLATO CON OPCIONES"/>
                    </VBox>
                </SplitPane>
            </Tab>

            <Tab text="GESTIÓN" closable="false">
                <VBox alignment="TOP_CENTER" spacing="18" style="-fx-padding: 30px;">
                    <Label text="GESTIÓN AVANZADA DEL RESTAURANTE" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0d47a1;"/>
                    <Label text="Configura presentaciones, inventario, proveedores y reportes sin alterar los módulos actuales." wrapText="true" style="-fx-text-fill: #555555;"/>

                    <GridPane hgap="18" vgap="18" alignment="CENTER">
                        <Button GridPane.columnIndex="0" GridPane.rowIndex="0" minWidth="250" prefHeight="70"
                                text="1. INGREDIENTES / RECETAS" onAction="#abrirIngredientes"
                                style="-fx-background-color:#6a1b9a;-fx-text-fill:white;-fx-font-size:15px;-fx-font-weight:bold;"/>
                        <Button GridPane.columnIndex="1" GridPane.rowIndex="0" minWidth="250" prefHeight="70"
                                text="2. INVENTARIO / ALMACÉN" onAction="#abrirInventario"
                                style="-fx-background-color:#2e7d32;-fx-text-fill:white;-fx-font-size:15px;-fx-font-weight:bold;"/>
                        <Button GridPane.columnIndex="0" GridPane.rowIndex="1" minWidth="250" prefHeight="70"
                                text="3. STOCK PLATOS" onAction="#abrirStockPlatos"
                                style="-fx-background-color:#0f766e;-fx-text-fill:white;-fx-font-size:15px;-fx-font-weight:bold;"/>
                        <Button GridPane.columnIndex="1" GridPane.rowIndex="1" minWidth="250" prefHeight="70"
                                text="4. PROVEEDORES / COMPRAS" onAction="#abrirProveedores"
                                style="-fx-background-color:#ef6c00;-fx-text-fill:white;-fx-font-size:15px;-fx-font-weight:bold;"/>
                        <Button GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2" minWidth="518" prefHeight="70"
                                text="5. REPORTES / CAJA" onAction="#abrirReportesAvanzados"
                                style="-fx-background-color:#1565c0;-fx-text-fill:white;-fx-font-size:15px;-fx-font-weight:bold;"/>
                    </GridPane>

                    <Separator prefWidth="540"/>
                    <Label text="Los platos simples se siguen creando en la pestaña PLATOS. Para makis, alitas, pizzas u otros productos con tamaños/presentaciones usa PLATOS CON OPCIONES."
                           maxWidth="560" wrapText="true" style="-fx-text-fill: #555555;"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #e0e0e0; -fx-padding: 10px;">
            <Button fx:id="btnRegresar" onAction="#regresar" style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 25px;" text="REGRESAR AL PRINCIPAL"/>
        </HBox>
    </bottom>

</BorderPane>
