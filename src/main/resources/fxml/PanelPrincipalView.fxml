<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.restaurante.controller.PanelPrincipalController">

    <padding>
        <Insets bottom="50" left="50" right="50" top="50"/>
    </padding>

    <Text fill="#1a237e" fontSmoothingType="GRAY" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-family: Arial; -fx-font-size: 28px; -fx-font-weight: bold;" text="RESTAURANTE LA FONDA" textAlignment="CENTER"/>

    <Text fill="#666666" fontSmoothingType="GRAY" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-family: Arial; -fx-font-size: 14px;" text="Seleccione su rol para continuar" textAlignment="CENTER"/>

    <Separator prefWidth="300.0"/>

    <VBox alignment="CENTER" spacing="15">
        <Button fx:id="btnMozo" onAction="#seleccionarMozo" prefWidth="250.0" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 15px 0px; -fx-background-radius: 8px; -fx-cursor: hand;" text="MOZO"/>

        <Button fx:id="btnCajero" onAction="#seleccionarCajero" prefWidth="250.0" style="-fx-background-color: #e65100; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 15px 0px; -fx-background-radius: 8px; -fx-cursor: hand;" text="CAJA"/>

        <Button fx:id="btnAdmin" onAction="#seleccionarAdmin" prefWidth="250.0" style="-fx-background-color: #0d47a1; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 15px 0px; -fx-background-radius: 8px; -fx-cursor: hand;" text="ADMINISTRADOR"/>

        <Button fx:id="btnCocina" onAction="#seleccionarCocina" prefWidth="250.0" style="-fx-background-color: #e65100; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 15px 0px; -fx-background-radius: 8px; -fx-cursor: hand;" text="COCINA"/>
    </VBox>

</VBox>