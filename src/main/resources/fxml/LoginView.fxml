<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="15" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.restaurante.controller.LoginController">

    <padding>
        <Insets bottom="40" left="40" right="40" top="40"/>
    </padding>

    <Text fx:id="txtTitulo" fill="#1a237e" fontSmoothingType="GRAY" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-family: Arial; -fx-font-size: 22px; -fx-font-weight: bold;" text="ACCESO" textAlignment="CENTER"/>

    <Text fx:id="txtSubtitulo" fill="#666666" fontSmoothingType="GRAY" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-family: Arial; -fx-font-size: 13px;" text="Ingrese sus credenciales" textAlignment="CENTER"/>

    <Separator prefWidth="280.0"/>

    <HBox alignment="CENTER_LEFT" spacing="10" prefWidth="300.0">
        <Label prefWidth="80.0" style="-fx-font-weight: bold;" text="DNI:"/>
        <TextField fx:id="txtDni" prefWidth="200.0" promptText="Ingrese su DNI" onAction="#handleLogin"/>
    </HBox>

    <HBox fx:id="passwordContainer" alignment="CENTER_LEFT" spacing="10" prefWidth="300.0" visible="false" managed="false">
        <Label prefWidth="80.0" style="-fx-font-weight: bold;" text="Clave:"/>
        <PasswordField fx:id="txtPassword" prefWidth="200.0" promptText="Ingrese su clave" onAction="#handleLogin"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnLogin" onAction="#handleLogin" prefWidth="200.0" style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 0px; -fx-background-radius: 5px;" text="INGRESAR"/>
    </HBox>

    <Label fx:id="lblError" alignment="CENTER" maxHeight="50.0" maxWidth="300.0" textFill="red" wrapText="true"/>

    <Label fx:id="lblAyuda" alignment="CENTER" maxHeight="30.0" maxWidth="300.0" textFill="#666" wrapText="true" style="-fx-font-size: 11px;"/>

</VBox>